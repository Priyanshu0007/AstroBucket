# AstroBucket Environment Configuration

# GitHub OAuth Client ID (obtained from GitHub Developer Settings)
VITE_GITHUB_CLIENT_ID=

# GitHub OAuth Redirect URI (must match the setting in GitHub exactly)
# For local development: http://localhost:5173/
# For production: https://astrobucket.vercel.app/
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/

# GitHub OAuth Client Secret (Keep secret! NEVER prefix with VITE_ or expose to client)
GITHUB_CLIENT_SECRET=
